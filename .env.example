# LLM (Gemini)
# Copy this file to .env and put your real key below. Never commit .env.
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3.1-flash-lite
LLM_TIMEOUT_SECONDS=10
LLM_MAX_ATTEMPTS=2

# Status thresholds (percent): above WARNING = WARNING, above CRITICAL = CRITICAL
WARNING_THRESHOLD=70
CRITICAL_THRESHOLD=85

# App
APP_ENV=development